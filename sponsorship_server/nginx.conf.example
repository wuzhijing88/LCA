# 放在 Nginx 的 http 块中；当前部署域名为 www.lcaa.top。
limit_req_zone $binary_remote_addr zone=lca_sponsor_orders:1m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name www.lcaa.top lcaa.top;
    server_tokens off;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
    }
    location / {
        return 301 https://www.lcaa.top$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name lcaa.top;
    server_tokens off;
    access_log off;
    ssl_certificate /etc/letsencrypt/live/lca-sponsorship/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lca-sponsorship/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://www.lcaa.top$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.lcaa.top;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/lca-sponsorship/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lca-sponsorship/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=2592000" always;
    client_max_body_size 8k;
    # 回调含支付签名、流水号，禁止写访问日志和共享缓存。
    access_log off;
    error_log /var/log/nginx/sponsorship.error.log crit;
    proxy_cache off;

    location = /orders {
        limit_req zone=lca_sponsor_orders burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
}
