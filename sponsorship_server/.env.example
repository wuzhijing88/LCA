# 必须填写；公开地址使用独立 HTTPS 域名，不带路径，例如 https://support.example.com。
SPONSOR_PUBLIC_URL=
# 当前官方网关（上线前对照自己的商户后台确认，协议文档 https://zpayz.cn/doc.html）。
ZPAY_GATEWAY_URL=https://zpayz.cn
ZPAY_PID=
ZPAY_KEY=
# 随机生成至少 32 字符，与商户密钥不同，例如 python -c "import secrets; print(secrets.token_urlsafe(48))"。
SPONSOR_CSRF_SECRET=
# 按商户实际开通的通道填写；仅一个通道时删除另一个，不能留空或使用别名。
ZPAY_PAYMENT_TYPES=alipay,wxpay
SPONSOR_DATABASE=/data/sponsorship.sqlite3
